body {
    background-color: #e6f4ff;
    font-family: "Noto Sans Kannada", Arial, sans-serif;
    max-width: 1000px;
    margin: auto;
    padding: 20px;
    color: #222;
}

/* Header */
header {
    background-color: #e6f4ff;
    color: #003366;
    padding: 35px 20px;
    text-align: center;
}

header h1 {
    font-size: 36px;
    font-weight: bold;
    color: #003366;
    margin: 10px 0 25px;
}


/* Navigation */
nav {
    margin-top: 20px;
}

nav a {
    display: inline-block;
    margin: 0 15px;
    padding: 10px 5px;
    text-decoration: none;
    color: #003366;
    font-size: 18px;
    font-weight: bold;
}

nav a:hover {
    color: #0066cc;
    text-decoration: underline;
}


/* Main content */
.hero {
    background-color: #e6f4ff;
    padding: 30px;
    margin-top: 30px;
}

h2 {
    color: #003366;
    font-size: 28px;
    margin-top: 35px;
}

h3 {
    color: #00509e;
}

p {
    font-size: 18px;
    line-height: 1.8;
}


/* Gallery */
.gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
}

.gallery img {
    width: 300px;
    height: 200px;
    object-fit: cover;
    border-radius: 10px;
}


/* Footer */
footer {
    background-color: #0b6fa4;
    color: white;
    padding: 20px;
    text-align: center;
    margin-top: 40px;
}


/* Mobile */
@media (max-width:600px) {

    nav a {
        display:block;
        margin:12px;
    }

    .gallery img {
        width:100%;
        height:auto;
    }

}

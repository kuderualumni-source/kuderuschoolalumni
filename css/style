/* Entire website background */
body {
    background-color: #e6f4ff;
    font-family: "Noto Sans Kannada", Arial, sans-serif;
    margin: 0;
    padding: 20px;
    color: #222;
}


/* Website container */
header,
.hero,
footer {
    background-color: transparent;
}


/* Header */
header {
    text-align: center;
    padding: 30px 20px;
}

header h1 {
    color: #003366;
    font-size: 36px;
    font-weight: bold;
    margin: 10px;
}


/* Navigation */
nav {
    margin-top: 25px;
}

nav a {
    display: inline-block;
    margin: 0 15px;
    padding: 10px;
    text-decoration: none;
    color: #003366;
    font-size: 18px;
    font-weight: bold;
}

nav a:hover {
    color: #0066cc;
    text-decoration: underline;
}


/* Main headings */
h2 {
    color: #003366;
    font-size: 28px;
    margin-top: 35px;
}


/* Paragraphs */
p {
    font-size: 18px;
    line-height: 1.8;
}


/* Content section */
.hero {
    padding: 30px;
}


/* Gallery */
.gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
}

.gallery img {
    width: 300px;
    height: 200px;
    object-fit: cover;
    border-radius: 10px;
}


/* Footer */
footer {
    background-color: #0b6fa4;
    color: white;
    padding: 20px;
    text-align: center;
    margin-top: 40px;
}


/* Mobile view */
@media(max-width:600px){

    nav a {
        display:block;
        margin:10px;
    }

    .gallery img {
        width:100%;
        height:auto;
    }
}
/* Website title */
header h1:first-child {
    font-size: 38px;
    color: #003366;
    margin-bottom: 5px;
}

header h1:nth-child(2) {
    font-size: 26px;
    color: #003366;
    margin-top: 0;
}


/* Navigation spacing */
nav {
    margin-top: 35px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 25px;
}

nav a {
    display: inline-block;
    text-align: center;
    color: #003366;
    font-weight: bold;
    font-size: 18px;
    text-decoration: none;
    line-height: 1.8;
}


/* Kannada second line in menu */
nav a br + * {
    font-size: 14px;
}


/* Main content English */
.hero h2 {
    font-size: 32px;
    color: #003366;
    margin-top: 40px;
}


/* Main content Kannada */
.hero h2:nth-of-type(even) {
    font-size: 24px;
}


/* Paragraph English */
.hero p {
    font-size: 20px;
    line-height: 1.8;
    margin-bottom: 35px;
}
nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin-top: 35px;
}


nav a {
    width: 120px;
    text-align: center;
    text-decoration: none;
    color: #003366;
}


/* Kannada first - smaller */
.kannada {
    display: block;
    font-size: 14px;
    color: #003366;
    margin-bottom: 5px;
}


/* English second - bigger */
.english {
    display: block;
    font-size: 20px;
    font-weight: bold;
    color: #003366;
}


nav a:hover .english {
    color: #0066cc;
}

/* Better separation between English and Kannada */
.hero h2 {
    margin-bottom: 20px;
}

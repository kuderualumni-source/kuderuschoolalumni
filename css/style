body{font-family:Arial,sans-serif;max-width:1000px;margin:auto;padding:20px}nav a{margin-right:15px}header,footer{background:#0b6fa4;color:#fff;padding:15px}.hero{background:#eee;padding:30px}
.gallery {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}

.gallery img {
  width: 300px;
  height: 200px;
  object-fit: cover;
  border-radius: 10px;
}

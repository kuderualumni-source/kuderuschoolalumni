/* Entire website background */
body {
    background-color: #e6f4ff;
    font-family: "Noto Sans Kannada", Arial, sans-serif;
    margin: 0;
    padding: 20px;
    color: #222;
}


/* Website container */
header,
.hero,
footer {
    background-color: transparent;
}


/* Header */
header {
    text-align: center;
    padding: 30px 20px;
}

header h1 {
    color: #003366;
    font-size: 36px;
    font-weight: bold;
    margin: 10px;
}


/* Navigation */
nav {
    margin-top: 25px;
}

nav a {
    display: inline-block;
    margin: 0 15px;
    padding: 10px;
    text-decoration: none;
    color: #003366;
    font-size: 18px;
    font-weight: bold;
}

nav a:hover {
    color: #0066cc;
    text-decoration: underline;
}


/* Main headings */
h2 {
    color: #003366;
    font-size: 28px;
    margin-top: 35px;
}


/* Paragraphs */
p {
    font-size: 18px;
    line-height: 1.8;
}


/* Content section */
.hero {
    padding: 30px;
}


/* Gallery */
.gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
}

.gallery img {
    width: 300px;
    height: 200px;
    object-fit: cover;
    border-radius: 10px;
}


/* Footer */
footer {
    background-color: #0b6fa4;
    color: white;
    padding: 20px;
    text-align: center;
    margin-top: 40px;
}


/* Mobile view */
@media(max-width:600px){

    nav a {
        display:block;
        margin:10px;
    }

    .gallery img {
        width:100%;
        height:auto;
    }
}
